<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.spizganed.quickbuds">

    <uses-feature android:name="android.software.companion_device_setup" android:required="true" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Up to Android 11: BLE scans need it. All versions: Disconnect locations (asked when the user turns it on). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Disconnect locations with the app closed ("Allow all the time"). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Voice call answering (probe in Dev tools): the earbuds' microphone through the call link, in the
         background service. Asked only when the probe is armed or tried. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Widget taps tick through the vibrator (Haptics.tick); no view of ours is on screen then. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Loss protection: keeps signal reads going for a few minutes after the screen goes off (ProximityMonitor). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Sleep timer: an exact time, when the user allows it (Settings › Alarms and reminders). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Sleep timer: alarms do not survive a reboot; it is set again at boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Auto-answer (Earbud settings): see a ringing call, and answer it. Asked when the user turns it on. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- Auto-answer › Which calls: Android gives the caller's number only with this. Asked when a contact filter is chosen. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Voice answer: the caller's name from the contacts, for the spoken prompt. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
      Needed only so the app can hand a downloaded APK to Android's own package
      installer. The app never installs anything itself, and the user still
      confirms in the system dialog, so this is the narrow version of the
      permission rather than an installer role.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The hourly update check waits for a network (JobScheduler needs this for that constraint). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      ONLY for the crash reporter's API<=28 fallback path, where there is no
      MediaStore.Downloads to write through. On API 29+ this declaration is
      ignored and MediaStore is used instead, so no runtime prompt is ever shown
      on a modern device. Do not raise maxSdkVersion.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      NO versionCode / versionName here: they are in app/build.gradle.kts defaultConfig, the single
      source (see the note there). They used to sit on <application>, where Android ignores them, so
      PC builds up to 2026-09-23 shipped with no version at all.
    -->
    <!--
      NO android:theme on <application>, deliberately.

      Declaring a theme here makes the framework resolve it during Activity
      attach, which counts as an asset/resources access BEFORE onCreate runs. That
      left applyOverrideConfiguration() unusable: it threw
      "getResources() or getAssets() has already been called" on every launch, no
      matter how early in onCreate it was called (the trace pointed at
      ContextThemeWrapper.applyOverrideConfiguration).

      The per-activity theme is set by ThemeRes.apply() before super.onCreate
      instead, which runs before this attribute would ever have been read. If a
      theme is added back here, the app crashes on launch again.
    -->
    <!-- Voice music: the music apps it lists and controls (Android 11+ shows only declared kinds of apps). -->
    <queries>
        <intent><action android:name="android.media.browse.MediaBrowserService" /></intent>
        <intent><action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" /></intent>
        <intent><action android:name="android.intent.action.MEDIA_BUTTON" /></intent>
    </queries>

    <application
        android:name=".QuickBudsApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true">


        <!--
          Every activity below is locked to portrait — 2026-09-22, "the app should be
          portrait mode only no rotation." No layout in this app has a landscape variant, so an
          allowed rotation would just stretch/reflow the existing portrait layouts, not show a
          real landscape design. `screenOrientation` has no `<application>`-level equivalent; it
          has to be repeated on every `<activity>`.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.DevToolsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.EqActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.GestureActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.GoldenSoundActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.EarbudSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.DualDeviceActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.HomeLayoutActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.ReportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.ThemeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.PresetEditActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.UpdateActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.ModelActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.CatalogActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.UsageActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.AutoAnswerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.BikeModeActivity"
            android:exported="false" />
        <!-- Voice music: notification access, which Android requires to control other apps' music. Reads none. -->
        <service
            android:name=".music.MusicAccessService"
            android:exported="true"
            android:label="@string/vm_title"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity
            android:name=".ui.VoiceMusicActivity"
            android:exported="false" />
        <!-- Bike mode: a quick settings tile that turns auto-answer (3 s) on or off. -->
        <service
            android:name=".ui.BikeModeTile"
            android:exported="true"
            android:icon="@drawable/ic_bike"
            android:label="@string/bike_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <activity
            android:name=".ui.DisconnectPlacesActivity"
            android:exported="false" />
        <!-- Portrait: the compass heading follows the phone's own axes. -->
        <activity
            android:name=".ui.PlaceNavigatorActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.SleepTimerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- Not exported: our own alarm and Cancel; the system still delivers boot and package-replaced. -->
        <receiver
            android:name=".sleep.SleepTimerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- The hourly update check (JobScheduler): runs with the app closed. -->
        <service
            android:name=".ui.UpdateJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <!-- The sleep timer's few seconds in the foreground: audio focus needs one on Android 15+. -->
        <service
            android:name=".sleep.SleepFireService"
            android:foregroundServiceType="shortService"
            android:exported="false" />
        <!-- Portrait: the compass heading follows the phone's own axes. -->
        <activity
            android:name=".ui.FindNearbyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.LanguageActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|keyboard|keyboardHidden|navigation|touchscreen|smallestScreenSize|screenLayout"
            android:screenOrientation="portrait" />

        <!--
          FileProvider for the app-update flow. The downloaded APK lives in the
          app's private cache, which the package installer cannot read directly,
          so it is handed over as a content:// URI granting temporary read access.
          Authority must match UpdateActivity's FileProvider.getUriForFile call
          ("${applicationId}.fileprovider").
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".bluetooth.BudsService"
            android:foregroundServiceType="connectedDevice|microphone"
            android:stopWithTask="false"
            android:exported="false" />

        <receiver
            android:name=".bluetooth.KeepAliveReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.headset.profile.action.CONNECTION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.AncWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_anc_info" />
        </receiver>

        <receiver
            android:name=".widget.BatteryWidgetProvider"
            android:exported="true"
            android:label="@string/widget_pages_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_battery_info" />
        </receiver>

        <receiver
            android:name=".widget.BatteryOnlyWidgetProvider"
            android:exported="true"
            android:label="@string/widget_battery_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_battery_only_info" />
        </receiver>

        <receiver
            android:name=".widget.ControlsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_controls_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_controls_info" />
        </receiver>

        <!-- Exported: the launcher opens it when a widget is placed or reconfigured. -->
        <activity
            android:name=".widget.WidgetSetupActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.spizganed.quickbuds.widget.ANC_CYCLE" />
                <action android:name="com.spizganed.quickbuds.widget.TRANS" />
                <action android:name="com.spizganed.quickbuds.widget.OFF" />
                <action android:name="com.spizganed.quickbuds.widget.GAME_TOGGLE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
